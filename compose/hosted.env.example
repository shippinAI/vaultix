# Hosted: AngryVibes / shippin.ai operates. Copy to vaultix.env (not in git).
# Hub: leave VAULTIX_LABEL empty. Tenant box: set label (workshop).
VAULTIX_SKU=hosted
COMPOSE_PROFILES=local-cache
VAULTIX_CACHE_PROVIDER=dragonfly
VAULTIX_CACHE_URL=redis://cache:6379
SITE_URL=https://vaultix.shippin.cloud
# Set the actual reverse-proxy socket peers before serving behind an edge.
# Blank trusts no forwarding headers; the trusted edge must normalize X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
ENCRYPTION_KEY=
AUTH_SECRET=
VAULTIX_LABEL=
VAULTIX_PUBLIC_HOST=vaultix.shippin.cloud
VAULTIX_LICENSE_TIER=community
VAULTIX_LICENSE_SUBJECT=
VAULTIX_ENC_KEY=
POSTGRES_USER=vaultix
POSTGRES_PASSWORD=
POSTGRES_DB=vaultix
NOMEN_OIDC_ISSUER=https://auth.shippin.ai
# After Actions → GHCR:
# VAULTIX_ENGINE_IMAGE=ghcr.io/shippinai/vaultix:latest
# VAULTIX_PANEL_IMAGE=ghcr.io/shippinai/vaultix-panel:latest
