# Hosted: AngryVibes / shippin.ai operates. Copy to vaultix.env (not in git).
# Hub: leave VAULTIX_LABEL empty. Tenant box: set label (workshop).
VAULTIX_SKU=hosted
VAULTIX_LABEL=
VAULTIX_PUBLIC_HOST=vaultix.shippin.cloud
VAULTIX_LICENSE_TIER=membership
VAULTIX_LICENSE_SUBJECT=
VAULTIX_ENC_KEY=
POSTGRES_USER=vaultix
POSTGRES_PASSWORD=
POSTGRES_DB=vaultix
NOMEN_OIDC_ISSUER=https://auth.shippin.ai
# After Actions → GHCR:
# VAULTIX_ENGINE_IMAGE=ghcr.io/shippinai/vaultix:latest
# VAULTIX_PANEL_IMAGE=ghcr.io/shippinai/vaultix-panel:latest
