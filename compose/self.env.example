# Self-host: you operate this box. Copy to vaultix.env (not in git).
VAULTIX_SKU=self
COMPOSE_PROFILES=local-cache
VAULTIX_CACHE_PROVIDER=dragonfly
VAULTIX_CACHE_URL=redis://cache:6379
# External Redis: provider=redis; set URL; remove local-cache from COMPOSE_PROFILES.
# ElastiCache: provider=elasticache; use rediss://primary-endpoint:6379.
# Cluster: leave URL empty; set VAULTIX_CACHE_CLUSTER_HOSTS=configuration-endpoint:6379.
# Credentials can be supplied separately with VAULTIX_CACHE_USERNAME / VAULTIX_CACHE_PASSWORD.
VAULTIX_PUBLIC_HOST=vaultix.example.com
VAULTIX_LICENSE_TIER=community
SITE_URL=https://vaultix.example.com
# 32-byte hex. Lose this and the dump is paper.
ENCRYPTION_KEY=
AUTH_SECRET=
VAULTIX_ENC_KEY=
POSTGRES_USER=vaultix
POSTGRES_PASSWORD=
POSTGRES_DB=vaultix
NOMEN_OIDC_ISSUER=
VAULTIX_LOCAL_CLIENT_ID=
VAULTIX_LOCAL_CLIENT_SECRET=
