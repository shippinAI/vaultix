# Self-host: you operate this box. Copy to vaultix.env (not in git).
VAULTIX_SKU=self
VAULTIX_PUBLIC_HOST=vaultix.example.com
VAULTIX_LICENSE_TIER=community
SITE_URL=https://vaultix.example.com
# 32-byte hex. Lose this and the dump is paper.
ENCRYPTION_KEY=
AUTH_SECRET=
VAULTIX_ENC_KEY=
POSTGRES_USER=vaultix
POSTGRES_PASSWORD=
POSTGRES_DB=vaultix
NOMEN_OIDC_ISSUER=
VAULTIX_LOCAL_CLIENT_ID=
VAULTIX_LOCAL_CLIENT_SECRET=

# Free-tier shared Postgres: database name vaultix, one prefix per tenant.
# Provisioning sets VX_ISOLATION=prefix and DB_TABLE_PREFIX=vx_<sid>_
# (<sid> at most 8 characters; stem vx_<sid> is at most 11).
# Empty (omit) keeps historical unprefixed table names. Do not change a prefix
# after that tenant has migrated.
# VX_ISOLATION=prefix
# DB_TABLE_PREFIX=vx_a1b2c3d4_
# Per-tenant heap floor is 512MB. 256MB OOM-loops. Image default is 768.
# Shared-database tenants use DB_POOL_MAX=4. Dedicated instances can raise
# NODE_OPTIONS and DB_POOL_MAX (the code default is 10).
# NODE_OPTIONS=--max-old-space-size=512
# DB_POOL_MIN=0
# DB_POOL_MAX=4
# DB_REPLICA_POOL_MIN=0
# DB_REPLICA_POOL_MAX=4
# AUDIT_LOGS_DB_POOL_MIN=0
# AUDIT_LOGS_DB_POOL_MAX=4
