# Self-host: you operate this box. Copy to vaultix.env (not in git).
VAULTIX_SKU=self
VAULTIX_PUBLIC_HOST=vaultix.example.com
VAULTIX_LICENSE_TIER=community
SITE_URL=https://vaultix.example.com
# 32-byte hex. Lose this and the dump is paper.
ENCRYPTION_KEY=
AUTH_SECRET=
VAULTIX_ENC_KEY=
POSTGRES_USER=vaultix
POSTGRES_PASSWORD=
POSTGRES_DB=vaultix
NOMEN_OIDC_ISSUER=
VAULTIX_LOCAL_CLIENT_ID=
VAULTIX_LOCAL_CLIENT_SECRET=

# Free-tier shared Postgres: one database, one prefix per tenant process.
# Empty (omit) keeps historical unprefixed table names. Do not change a prefix
# after that tenant has migrated. Example stem: acme (stored as acme_).
# DB_TABLE_PREFIX=
# ~1GB container: keep the runtime heap near 768MB and a tiny pool so many
# tenants do not exhaust Postgres max_connections. Dedicated instances can
# raise NODE_OPTIONS and DB_POOL_MAX (the code default is 10).
# NODE_OPTIONS=--max-old-space-size=768
# DB_POOL_MIN=0
# DB_POOL_MAX=2
# DB_REPLICA_POOL_MIN=0
# DB_REPLICA_POOL_MAX=2
# AUDIT_LOGS_DB_POOL_MIN=0
# AUDIT_LOGS_DB_POOL_MAX=2
