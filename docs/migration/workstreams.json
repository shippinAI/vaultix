{
  "schemaVersion": 1,
  "direction": "Vaultix.cloud native React/Go/Rust product; DevSCIF.com profiles share the engine",
  "workstreams": [
    { "id": "foundation", "title": "Contracts, database compatibility and shared runtime", "dependsOn": [], "gates": ["schema-and-ciphertext-fixtures", "error-contracts", "included-features-not-authorization", "single-writer-cutover", "rollback-rehearsal"] },
    { "id": "identity", "title": "Nomen identity and workload authentication", "dependsOn": ["foundation"], "gates": ["real-issuer-audience-expiry", "session-and-logout-ownership", "tenant-mapping", "revocation"] },
    { "id": "authorization", "title": "Permissions, approvals and organization isolation", "dependsOn": ["identity"], "gates": ["cross-tenant-denial", "policy-differential-tests", "approval-parameter-binding", "revocation-races"] },
    { "id": "ui", "title": "Native React workflows and interaction system", "dependsOn": ["foundation"], "gates": ["route-continuity", "keyboard-and-screen-reader", "real-service-browser", "reflow-and-reduced-motion"] },
    { "id": "secrets", "title": "Projects, environments and encrypted secret lifecycle", "dependsOn": ["authorization"], "gates": ["create-update-version-restore", "imports-precedence-cycles", "ciphertext-compatibility", "no-values-in-metadata", "transaction-concurrency"] },
    { "id": "ai", "title": "Shared source actions, MCP and visible execution", "dependsOn": ["authorization", "secrets", "ui"], "gates": ["same-human-ai-authorization", "reference-only-input-output", "idempotency-and-cancel", "durable-redacted-receipts", "untrusted-content-denial"] },
    { "id": "delivery", "title": "Builds, toolchains, cache and hosted operation", "dependsOn": ["foundation"], "gates": ["canonical-image", "dragonfly-redis-elasticache", "backup-restore", "load-baseline", "signed-artifact-provenance"] },
    { "id": "cli", "title": "Go client and Rust application injection boundary", "dependsOn": ["ai", "delivery"], "gates": ["target-workload-binding", "single-use-expiry-replay", "agent-process-denial", "windows-linux-macos", "offline-policy"] },
    { "id": "automation", "title": "Rotation, dynamic leases and durable jobs", "dependsOn": ["secrets", "audit"], "gates": ["provider-reconciliation", "lease-expiry-revocation", "retry-idempotency", "queue-drain-and-cutover"] },
    { "id": "integrations", "title": "Connections, synchronization and provider adapters", "dependsOn": ["secrets", "audit"], "gates": ["per-provider-pagination", "rate-limit-recovery", "scope-minimization", "webhook-replay-denial", "real-provider-prerequisites"] },
    { "id": "audit", "title": "Audit, outbox, retention and export", "dependsOn": ["authorization"], "gates": ["transactional-outbox", "redaction", "durable-export", "retention-and-recovery", "operator-separation"] },
    { "id": "kms", "title": "KMS, HSM, CMKs and KMIP", "dependsOn": ["secrets", "audit"], "gates": ["key-rotation-rewrap-recovery", "provider-and-hsm-proofs", "kmip-interoperability", "crypto-known-answer-vectors"] },
    { "id": "pki", "title": "Certificates, CAs, enrollment and signing", "dependsOn": ["kms", "automation"], "gates": ["issuance-policy-denial", "acme-est-scep", "renewal-revocation", "signer-authorization", "external-ca-proof"] },
    { "id": "pam", "title": "Privileged access and session protocols", "dependsOn": ["authorization", "audit", "automation"], "gates": ["grant-expiry-revocation", "session-recording-integrity", "command-restrictions", "protocol-fuzzing", "resource-provider-proof"] },
    { "id": "scanning", "title": "Scanning, detection and honeytokens", "dependsOn": ["integrations", "audit"], "gates": ["fixture-corpus", "redacted-findings", "detector-delivery", "provider-outage", "resource-limits"] },
    { "id": "legacy-panel", "title": "Reconcile optional panel and retire duplicate paths", "dependsOn": ["ai", "cli"], "gates": ["feature-by-feature-replacement", "no-second-store", "no-second-auth-session", "operator-migration"] },
    { "id": "intake", "title": "Unclassified module investigation", "dependsOn": [], "gates": ["manual-domain-assignment", "caller-data-auth-trace", "explicit-target-decision"] }
  ],
  "rules": [
    { "pattern": "^\\.ai/|^\\.agents/", "workstream": "foundation" },
    { "pattern": "^docs/capabilities/", "workstream": "foundation" },
    { "pattern": "^go\\.mod$", "workstream": "cli" },
    { "pattern": "^branding/|^core/(company|img|docs)/|^docs/references/", "workstream": "ui" },
    { "pattern": "^core/[^/]+$|^core/(docker|docker-swarm|cloudformation|nginx|\\.husky|\\.greptile|upgrade-impact)/|^\\.gitignore$", "workstream": "delivery" },
    { "pattern": "^panel/", "workstream": "legacy-panel" },
    { "pattern": "^(cmd|internal)/", "workstream": "cli" },
    { "pattern": "^core/wasm/", "workstream": "pam" },
    { "pattern": "^(scripts/|compose/|\\.github/)|(^|/)(Dockerfile|Makefile)|^core/(helm-charts|deploy|scripts)/", "workstream": "delivery" },
    { "pattern": "^core/ai/|/vaultix/|/mcp[/.]|/guidance[.-]|/source/", "workstream": "ai" },
    { "pattern": "(pam|privileged|rdp|ssh|gateway|relay|proxied-service|agent-proxy-ca)", "workstream": "pam" },
    { "pattern": "(certificate|cert-manager|certmanager|pki|signer|enrollment)", "workstream": "pki" },
    { "pattern": "(kms|hsm|cmek|kmip|keystore)", "workstream": "kms" },
    { "pattern": "(scanning|honey-token|honeytoken)", "workstream": "scanning" },
    { "pattern": "(audit|outbox)", "workstream": "audit" },
    { "pattern": "(approval|permission|privilege|membership|trusted-ip|accesscontrol|access-control|/role[/.s-]|/group[/.s-])", "workstream": "authorization" },
    { "pattern": "(rotation|dynamic-secret|dynamicsecret|lease|reminder|workflow-integration)", "workstream": "automation" },
    { "pattern": "(integration|app-connection|appconnection|secret-sync|secretsync|replication|webhook|github-app|github-org-sync)", "workstream": "integrations" },
    { "pattern": "(identity|/auth|/user|/login|/signup|oidc|saml|scim|webauthn|totp|mfa|ldap|oauth|account-recovery)", "workstream": "identity" },
    { "pattern": "(/secret|/project|/folder|/environment|/pit/|secretmanager)", "workstream": "secrets" },
    { "pattern": "^core/frontend/|^web/", "workstream": "ui" },
    { "pattern": "^core/(backend|backend-go|e2e|sink)/|^db/|^contracts/|^schemas/|^docs/migration/", "workstream": "foundation" },
    { "pattern": ".*", "workstream": "intake" }
  ]
}
