  <Applications>
    <Application Id="Vaultix" Executable="vaultix.exe" uap10:Subsystem="console" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL" uap10:SupportsMultipleInstances="true">
