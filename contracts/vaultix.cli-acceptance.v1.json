{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaultix.cloud/contracts/vaultix.cli-acceptance.v1.json",
  "title": "Vaultix accepted native CLI generation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "acceptedAt", "checkpoint"],
  "properties": {
    "schemaVersion": {"const": "vaultix.cli-acceptance.v1"},
    "acceptedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "checkpoint": {"$ref": "https://vaultix.cloud/contracts/vaultix.release-checkpoint.v1.json"}
  }
}
