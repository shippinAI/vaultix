{
  "openapi": "3.0.3",
  "info": {
    "title": "Vaultix native core API",
    "version": "1.0.0",
    "description": "Native Vaultix guidance and authenticated metadata actions. UI and MCP share the same reference service and authorization. Secret values are excluded. Nomen hosted client integration remains a release gate."
  },
  "servers": [
    {
      "url": "/api/v1/vaultix"
    }
  ],
  "paths": {
    "/product": {
      "get": {
        "operationId": "vaultixProduct",
        "summary": "Read product identity and implementation status",
        "responses": {
          "200": {
            "description": "Product metadata, included feature policy, authenticated reference AI status, and cache provider choices"
          }
        }
      }
    },
    "/catalog": {
      "get": {
        "operationId": "vaultixCatalog",
        "summary": "Read the same authored catalog used by the UI and Clyffy",
        "responses": {
          "200": {
            "description": "vaultix.catalog.v1 document with source=catalog and entries containing id, title, description"
          }
        }
      }
    },
    "/configure": {
      "get": {
        "operationId": "vaultixConfigure",
        "summary": "Read authored setup steps",
        "responses": {
          "200": {
            "description": "vaultix.configure.v1 document containing allowlisted configure-step components"
          }
        }
      }
    },
    "/ai/instructions": {
      "get": {
        "operationId": "vaultixSpecialistInstructions",
        "summary": "Read Clyffy's operating instructions",
        "responses": {
          "200": {
            "description": "Specialist instructions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "instructions"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "instructions": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "vaultixMcp",
        "summary": "Stateless JSON-RPC for authored guidance and authenticated reference actions",
        "description": "16 KiB request limit. Public guidance tools take empty arguments. Authenticated clients can call vaultix.projects.list and vaultix.secrets.references with the same validation and permissions as the UI. No secret values or mutations. HTTP errors use a plain error string. Protocol errors use JSON-RPC error objects.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "enum": [
                      "2.0"
                    ]
                  },
                  "id": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "maxLength": 128
                      }
                    ]
                  },
                  "method": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC result or protocol error"
          },
          "202": {
            "description": "Notification accepted; empty body"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "403": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "413": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "429": {
            "$ref": "#/components/responses/InvalidRequest"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "vaultixProjects",
        "summary": "List authorized apps and environments",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized apps and environments. No project encryption settings.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Projects" } } }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "429": {
            "$ref": "#/components/responses/InvalidRequest"
          }
        }
      }
    },
    "/secret-references": {
      "get": {
        "operationId": "vaultixSecretReferences",
        "summary": "List authorized shared secret references without loading ciphertext",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "No values, comments, custom metadata, personal overrides, imports, or recursive traversal. A filtered page may be empty. Follow nextOffset until null. Each read uses current engine authorization and is audited.",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          {
            "name": "secretPath",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1024,
              "default": "/"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized shared secret names and pagination, without secret payloads.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReferencePage" } } }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "429": {
            "$ref": "#/components/responses/InvalidRequest"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Environment": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "slug"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }, "slug": { "type": "string" }
        }
      },
      "Projects": {
        "type": "object", "additionalProperties": false,
        "required": ["narration", "projects"],
        "properties": {
          "narration": { "type": "string" },
          "projects": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "name", "slug", "environments"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "name": { "type": "string" }, "slug": { "type": "string" },
                "environments": { "type": "array", "items": { "$ref": "#/components/schemas/Environment" } }
              }
            }
          }
        }
      },
      "ReferencePage": {
        "type": "object", "additionalProperties": false,
        "required": ["narration", "projectId", "environment", "secretPath", "references", "nextOffset"],
        "properties": {
          "narration": { "type": "string" },
          "projectId": { "type": "string", "format": "uuid" },
          "environment": { "type": "string" }, "secretPath": { "type": "string" },
          "nextOffset": { "type": "integer", "minimum": 0, "nullable": true },
          "references": {
            "type": "array", "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "name", "version", "createdAt", "updatedAt"],
              "properties": {
                "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" },
                "version": { "type": "integer" },
                "createdAt": { "type": "string", "format": "date-time" },
                "updatedAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Request rejected without reflecting its input",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Validated existing Vaultix user or machine identity token. No caller-supplied tenant or actor overrides. Delegated OAuth tokens are not accepted by these new actions."
      }
    }
  }
}
