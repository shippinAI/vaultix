{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaultix.cloud/contracts/vaultix.ui-benchmark-receipt.v1.schema.json",
  "title": "Vaultix scripted-event benchmark receipt v1",
  "description": "Receipt contract for parity benchmark evidence comparing scripted events and Playwright-style browser automation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "generated_at",
    "workflow",
    "parity_gate",
    "runs",
    "summary",
    "anti_gaming",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "vaultix.ui-benchmark-receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^vaultix\\.benchmark\\.[a-z0-9.-]{4,180}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "surface",
        "scenario",
        "seed"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^vaultix\\.ui\\.[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$"
        },
        "surface": {
          "enum": [
            "public",
            "auth",
            "tenant"
          ]
        },
        "scenario": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "parity_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_login_state",
        "same_tenant_scope",
        "same_mutation_count",
        "same_completion_criteria",
        "same_error_policy",
        "valid"
      ],
      "properties": {
        "same_login_state": {
          "type": "boolean"
        },
        "same_tenant_scope": {
          "type": "boolean"
        },
        "same_mutation_count": {
          "type": "boolean"
        },
        "same_completion_criteria": {
          "type": "boolean"
        },
        "same_error_policy": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "winner",
        "token_reduction_percent",
        "latency_reduction_percent",
        "screenshot_reduction_percent"
      ],
      "properties": {
        "winner": {
          "enum": [
            "scripted-events",
            "playwright",
            "tie"
          ]
        },
        "token_reduction_percent": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "latency_reduction_percent": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "screenshot_reduction_percent": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    },
    "anti_gaming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_seed_data",
        "failure_cases_included",
        "confirmations_preserved",
        "notes"
      ],
      "properties": {
        "fixed_seed_data": {
          "type": "boolean"
        },
        "failure_cases_included": {
          "type": "boolean"
        },
        "confirmations_preserved": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_or_live",
        "scripted_log",
        "playwright_log",
        "secret_scan_clean"
      ],
      "properties": {
        "fixture_or_live": {
          "enum": [
            "fixture",
            "live-provider"
          ]
        },
        "scripted_log": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "playwright_log": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "secret_scan_clean": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "input_tokens",
        "output_tokens",
        "model_calls",
        "latency_ms",
        "browser_actions",
        "screenshots",
        "screenshot_bytes",
        "cpu_ms",
        "peak_memory_mb",
        "error_rate",
        "recovery_success_rate"
      ],
      "properties": {
        "method": {
          "enum": [
            "scripted-events",
            "playwright"
          ]
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 1
        },
        "browser_actions": {
          "type": "integer",
          "minimum": 0
        },
        "screenshots": {
          "type": "integer",
          "minimum": 0
        },
        "screenshot_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_ms": {
          "type": "integer",
          "minimum": 1
        },
        "peak_memory_mb": {
          "type": "number",
          "minimum": 1
        },
        "error_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recovery_success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
