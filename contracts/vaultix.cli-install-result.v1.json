{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaultix.cloud/contracts/vaultix.cli-install-result.v1.json",
  "title": "Vaultix native CLI installation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "directory", "binDirectory", "version", "revision", "platform", "checkpoint", "changed", "previousDirectory", "verified"],
  "properties": {
    "schemaVersion": {"const": "vaultix.cli-install-result.v1"},
    "directory": {"type": "string", "minLength": 1},
    "binDirectory": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "platform": {"const": "linux/amd64"},
    "checkpoint": {"$ref": "https://vaultix.cloud/contracts/vaultix.release-checkpoint.v1.json"},
    "changed": {"type": "boolean"},
    "previousDirectory": {"type": "string"},
    "verified": {"const": true}
  }
}
