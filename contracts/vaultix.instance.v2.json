{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaultix.cloud/contracts/vaultix.instance.v2.json",
  "title": "Vaultix instance with explicitly enrolled proxy bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "project",
    "siteUrl",
    "port",
    "daemon",
    "proxyBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "vaultix.instance.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "siteUrl": {
      "type": "string",
      "format": "uri"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "daemon": {
      "type": "string",
      "minLength": 1
    },
    "proxyBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostIp",
          "port"
        ],
        "properties": {
          "hostIp": {
            "anyOf": [
              {
                "type": "string",
                "format": "ipv4"
              },
              {
                "type": "string",
                "format": "ipv6"
              }
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    }
  }
}
