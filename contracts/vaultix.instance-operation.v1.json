{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaultix.cloud/contracts/vaultix.instance-operation.v1.json",
  "title": "Vaultix single-instance lifecycle result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance",
    "operation",
    "ready",
    "recoveryRequired",
    "message"
  ],
  "properties": {
    "instance": {
      "anyOf": [
        {
          "$ref": "#/$defs/instance"
        },
        {
          "$ref": "https://vaultix.cloud/contracts/vaultix.instance.v2.json"
        }
      ]
    },
    "operation": {
      "anyOf": [
        {
          "$ref": "#/$defs/state"
        },
        {
          "type": "null"
        }
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "recoveryRequired": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "setupCode": {
      "description": "The one-time first-owner code. Present only while the running application still requires it (docs/0118).",
      "type": "string",
      "minLength": 1
    },
    "setupUrl": {
      "description": "Where the first owner signs up. Present only together with setupCode.",
      "type": "string",
      "minLength": 1
    },
    "passwordResetLink": {
      "description": "Present only on owner-reset-link: a one-use, 24-hour reset link for an instance administrator. A credential; never pasted into chat (INSTALL-FOR-AI.md).",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "username", "expiresAt"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "backup": {
      "description": "Present only on backup: the backup just written, kept because it restored cleanly into an isolated copy (docs/0109, Backups).",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "createdAt", "databaseHash", "environmentHash", "migrations", "secrets", "verified"],
      "properties": {
        "name": { "type": "string", "pattern": "^backup-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "image": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "databaseHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "environmentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "migrations": { "type": "integer", "minimum": 1 },
        "secrets": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verified": { "const": true }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "revision",
        "migrations",
        "evidence",
        "trust"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "migrations": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trust": {
          "enum": [
            "local-build",
            "signed-bundle",
            "existing-instance"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "checkpoint": {
          "$ref": "https://vaultix.cloud/contracts/vaultix.release-checkpoint.v1.json"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "applied",
        "pending"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "applied": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pending": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
          }
        },
        "secrets": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "project",
        "siteUrl",
        "port",
        "daemon"
      ],
      "properties": {
        "schemaVersion": {
          "const": "vaultix.instance-operation.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "siteUrl": {
          "type": "string",
          "format": "uri"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "daemon": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sequence",
        "previous",
        "operation",
        "action",
        "phase",
        "configuration",
        "candidate",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "vaultix.instance-operation.v1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "previous": {
          "type": "string",
          "pattern": "^([a-f0-9]{64})?$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "action": {
          "enum": [
            "install",
            "adopt",
            "upgrade",
            "rollback"
          ]
        },
        "phase": {
          "enum": [
            "planned",
            "dependencies",
            "stopping",
            "snapshot",
            "rehearsing",
            "migrating",
            "reverting",
            "restoring",
            "replacing",
            "validating",
            "ready"
          ]
        },
        "configuration": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "priorImage": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "priorContainer": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "database": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "databaseImage": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "databaseVolume": {
          "type": "string",
          "minLength": 1
        },
        "cache": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "backup": {
          "type": "string",
          "pattern": "^op-[a-z0-9-]+\\.database\\.age$"
        },
        "backupHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environmentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "migration": {
          "$ref": "#/$defs/migration"
        },
        "prior": {
          "$ref": "#/$defs/candidate"
        },
        "reverted": {
          "$ref": "#/$defs/candidate"
        },
        "revertedFrom": {
          "enum": [
            "planned",
            "stopping",
            "snapshot",
            "rehearsing",
            "migrating",
            "replacing",
            "validating",
            "ready"
          ]
        },
        "retainedCheckpoint": {
          "$ref": "https://vaultix.cloud/contracts/vaultix.release-checkpoint.v1.json"
        },
        "retainedDatabase": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
