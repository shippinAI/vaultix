# GHCR engine image: vaultix MIT pin, renamed Vaultix.
# Secrets UI + API. No Oracle Instant Client, no OpenSSL-from-source, no Go sidecar
# (sidecar spawn is off). Those extras filled GitHub-hosted disks.
# Local/full standalone remains Dockerfile.standalone-vaultix.
ARG POSTHOG_HOST=https://app.posthog.com
ARG POSTHOG_API_KEY=posthog-api-key
ARG INTERCOM_ID=intercom-id
ARG CAPTCHA_SITE_KEY=captcha-site-key
ARG VAULTIX_PLATFORM_VERSION=0.162.19

FROM node:22.22.0-trixie-slim AS base
RUN npm install -g npm@10.9.0

FROM base AS frontend-deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts

FROM base AS frontend-builder
WORKDIR /app
COPY --from=frontend-deps /app/node_modules ./node_modules
COPY frontend .
ENV NODE_ENV=production
ARG POSTHOG_HOST
ENV VITE_POSTHOG_HOST=$POSTHOG_HOST
ARG POSTHOG_API_KEY
ENV VITE_POSTHOG_API_KEY=$POSTHOG_API_KEY
ARG INTERCOM_ID
ENV VITE_INTERCOM_ID=$INTERCOM_ID
ARG VAULTIX_PLATFORM_VERSION
ENV VAULTIX_PLATFORM_VERSION=$VAULTIX_PLATFORM_VERSION
ENV VITE_VAULTIX_PLATFORM_VERSION=$VAULTIX_PLATFORM_VERSION
ARG CAPTCHA_SITE_KEY
ENV VITE_CAPTCHA_SITE_KEY=$CAPTCHA_SITE_KEY
ENV NODE_OPTIONS="--max-old-space-size=4096"
# Vite emit only. tsc is verified in CI owned/dev; skip it here to save RAM/disk.
RUN npx vite build

FROM base AS backend-build
WORKDIR /app
RUN apt-get update && apt-get install -y python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY backend/package*.json ./
RUN npm ci
COPY backend .
COPY standalone-entrypoint.sh ./standalone-entrypoint.sh
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build
RUN npm ci --omit=dev && npm cache clean --force

FROM base AS production
RUN apt-get update && apt-get install -y ca-certificates bash wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs non-root-user \
    && chown -R non-root-user /etc/ssl/certs \
    && chmod u+rx /usr/sbin/update-ca-certificates

WORKDIR /backend
COPY --from=backend-build --chown=non-root-user:nodejs /app/dist ./dist
COPY --from=backend-build --chown=non-root-user:nodejs /app/node_modules ./node_modules
COPY --from=backend-build --chown=non-root-user:nodejs /app/package.json ./package.json
COPY --from=backend-build --chown=non-root-user:nodejs /app/standalone-entrypoint.sh ./standalone-entrypoint.sh
COPY --from=frontend-builder --chown=non-root-user:nodejs /app/dist ./frontend-build
RUN chmod +x ./standalone-entrypoint.sh

ARG VAULTIX_PLATFORM_VERSION=0.162.19
ENV VAULTIX_PLATFORM_VERSION=$VAULTIX_PLATFORM_VERSION
LABEL org.opencontainers.image.title="Vaultix"
LABEL org.opencontainers.image.description="Shippin secrets you own"
LABEL org.opencontainers.image.url="https://vaultix.shippin.cloud"
LABEL org.opencontainers.image.source="https://github.com/shippinAI/vaultix"
LABEL org.opencontainers.image.vendor="AngryVibes LLC"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.version="${VAULTIX_PLATFORM_VERSION}"

ENV PORT=8080
ENV HOST=0.0.0.0
ENV HTTPS_ENABLED=false
ENV NODE_ENV=production
ENV STANDALONE_BUILD=true
ENV STANDALONE_MODE=true
ENV TELEMETRY_ENABLED=false
ENV LICENSE_SERVER_URL=""
ENV LICENSE_SERVER_V2_MODE=off
ENV NODE_OPTIONS="--max-old-space-size=2048"
ENV GO_SIDECAR_SPAWN_ENABLED=false

EXPOSE 8080
USER 1001
CMD ["./standalone-entrypoint.sh"]
